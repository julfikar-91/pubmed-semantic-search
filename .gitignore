# =============================================================================
# Root .gitignore for PubMed Semantic Search (FastAPI + Vite/React/TS Monorepo)
# =============================================================================

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.p12

# --- Large Medical Datasets, Raw XML & Binary Dictionaries ---
*.xml
*.gz
*.pkl
*.pkl.gz
# Allow only the pre-compiled MeSH dictionary cache (5MB) for production deployment
!backend/data/mesh_dictionary_cache.pkl.gz
!data/mesh_dictionary_cache.pkl.gz
*.parquet
*.sqlite
*.sqlite3
*.db
*.fa
*.fasta
*.obo
scratch_*.json


# --- Python / Backend Virtual Environments & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/

# Logs & Debugging
*.log
logs/
*.pid

# --- Node / Frontend Artifacts & Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build Outputs
frontend/dist/
dist/
dist-ssr/
*.local

# TypeScript / Linter Caches
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# --- IDEs, Editors & Operating System Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
