# PubMed Semantic Search Backend Environment Configuration
# Copy this file to .env and fill in your actual credentials

# NCBI Entrez PubMed API (Optional - raises rate limit from 3 req/sec to 10 req/sec)
NCBI_API_KEY=
NCBI_EMAIL=researcher@example.com

# LLM Provider for Synonym Expansion ("openai", "gemini", or "mock")
# When set to "mock", uses the built-in MeSH/UMLS medical dictionary without requiring an external API key.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Store & Embedding Model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CACHE_TTL_SECONDS=3600
DEBUG=True
